# Practica Parametros
# Ejercicio 1: Escribir un procedimiento Mover3VecesAl_(direcciónAMover) que dada una dirección 
# mueva el cabezal tres posiciones en dicha dirección.

INICIAR_TABLERO(4, 4)

TECNICA Mover3VecesAl_(direccionAMover) {
    # Mueve el cabezal tres celdas en la dirección indicada por el parámetro direcciónAMover.
    # Pre: Al menos debe haber tres celdas hacia direcciónAMover partiendo de la posición actual.
    # Param: direcciónAMover - Tipo: Dirección - Indica la dirección en la que se mueve el cabezal.
    GRAVEDAD 3 {
        VOLAR(direccionAMover)
    }
}

Mover3VecesAl_(NORTE)

MOSTRAR_TABLERO()

