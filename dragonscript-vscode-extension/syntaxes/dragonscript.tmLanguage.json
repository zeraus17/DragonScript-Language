{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "name": "DragonScript",
    "scopeName": "source.dragonscript",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#functions"
        },
        {
            "include": "#constants"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.dragonscript",
                    "match": "#.*$"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.dragonscript",
                    "match": "\\b(SENSAR|ESQUIVAR|ENTRENAR|RASTREAR|EN|TRANSMITIR|GRAVEDAD|IF|ELSE|WHILE|FOREACH|RETURN|GRAVITY)\\b"
                },
                {
                    "name": "storage.type.class.dragonscript",
                    "match": "\\b(CAPSULA|ACTIVAR|EVOLUCIONA|LEGENDARIO|WARRIOR|CREATE|INVOCAR|EVOLVES|STATIC)\\b"
                },
                {
                    "name": "variable.language.self.dragonscript",
                    "match": "\\b(YO|SELF)\\b"
                },
                {
                    "name": "keyword.other.dragonscript",
                    "match": "\\b(KI|SCOUTER|TECNICA|TECHNIQUE|ROSHI|TRANSFORM|POTARA|KAIOKEN|SENZU|CAPSULE|FIND|DRAGON_BALL|SUMMON|WISH|INSTANT_TRANSMISSION)\\b"
                },
                {
                    "name": "keyword.operator.logical.dragonscript",
                    "match": "\\b(FUSION|DESEO|INVERTIR|AND|OR|NOT)\\b"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "name": "constant.language.boolean.dragonscript",
                    "match": "\\b(CANON|RELLENO|TRUE|FALSE)\\b"
                },
                {
                    "name": "constant.language.null.dragonscript",
                    "match": "\\b(VACIO|NULL)\\b"
                },
                {
                    "name": "constant.language.board.dragonscript",
                    "match": "\\b(NORTE|SUR|ESTE|OESTE|ESFERA_1|ESFERA_2|ESFERA_3|ESFERA_4|GUERRERO)\\b"
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.dragonscript",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [
                        {
                            "name": "constant.character.escape.dragonscript",
                            "match": "\\\\(n|t|r|\\\\|\")"
                        }
                    ]
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.float.dragonscript",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.dragonscript",
                    "match": "\\b\\d+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.dragonscript",
                    "match": "\\+|\\-|\\*|\\/|%"
                },
                {
                    "name": "keyword.operator.comparison.dragonscript",
                    "match": "==|!=|<=|>=|<|>"
                },
                {
                    "name": "keyword.operator.assignment.dragonscript",
                    "match": "=|\\+=|\\-=|\\*=|\\/="
                },
                {
                    "name": "keyword.operator.arrow.dragonscript",
                    "match": "->"
                }
            ]
        },
        "functions": {
            "patterns": [
                {
                    "name": "entity.name.function.dragonscript",
                    "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
                },
                {
                    "name": "support.function.builtin.dragonscript",
                    "match": "\\b(ABS|SQRT|POW|MAX|MIN|ROUND|FLOOR|CEIL|LEN|STR|NUM|INPUT|LONGITUD|ESTA_VACIA|CABEZA|COLA|ABSORBER|RANGO|INICIAR_TABLERO|VOLAR|PUEDE_VOLAR|CARGAR|DRENAR|HAY|CUANTAS|POSICION_X|POSICION_Y|MOSTRAR_TABLERO)\\b"
                }
            ]
        }
    }
}