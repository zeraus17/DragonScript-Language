{
    "name": "dragonscript",
    "displayName": "DragonScript Language Support",
    "description": "Soporte de sintaxis para el lenguaje DragonScript inspirado en Dragon Ball",
    "version": "0.1.0",
    "publisher": "zeraus17",
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "dragonscript",
        "dragon ball",
        "programming language",
        "interpreter"
    ],
    "contributes": {
        "languages": [
            {
                "id": "dragonscript",
                "aliases": [
                    "DragonScript",
                    "dragonscript"
                ],
                "extensions": [
                    ".ds"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icon.png",
                    "dark": "./icon.png"
                }
            }
        ],
        "grammars": [
            {
                "language": "dragonscript",
                "scopeName": "source.dragonscript",
                "path": "./syntaxes/dragonscript.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "dragonscript",
                "path": "./snippets/dragonscript.json"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/zeraus17/DragonScript.git"
    },
    "license": "MIT"
}
